# Example settings for Jot. Copy this file to ".env" (next to docker-compose.yml),
# change what you need, then run:  docker compose up -d
# Every line is optional; without a .env file Jot uses the defaults shown.

# The address bots use to reach Jot, without /mcp on the end.
# The Account page shows it under "Bots". Set this to your public HTTPS address
# once a proxy is serving it. It only changes what is displayed; it does not
# make Jot reachable by itself.
# Default: http://localhost:9003
JOT_PUBLIC_URL=https://jot.example.com

# The user and group the app runs as, so files in ./data belong to you.
# Run "id -u" and "id -g" on the server; only change these if they are not 1000.
# Default: 1000 and 1000
JOT_UID=1000
JOT_GID=1000

# Set to 1 only if people reach the web app itself (not just /mcp) over HTTPS.
# The login cookie is then sent over HTTPS only, so logging in over plain
# http://...:9003 stops working. Leave it out if the app is only used on your
# own network over HTTP.
# Default: off
# JOT_SECURE_COOKIES=1
