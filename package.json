{
  "name": "jot",
  "version": "1.0.0",
  "private": true,
  "description": "Jot: a private, multi-user note-taking web app",
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/server/main.ts",
    "cli": "node --import tsx src/cli/main.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:isolation": "vitest run tests/isolation",
    "test:api": "vitest run tests/api",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "test:cli": "vitest run tests/cli",
    "test:db": "vitest run tests/db",
    "test:component": "vitest run tests/component"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.9",
    "@fastify/static": "10.1.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "argon2": "0.45.2",
    "better-sqlite3": "13.2.0",
    "fastify": "5.12.8",
    "markdown-it": "15.0.3",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-highlight": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-link": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extension-text-style": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@univerjs/preset-sheets-core": "1.6.1",
    "@univerjs/presets": "1.6.1",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
